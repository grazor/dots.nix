#!/usr/bin/env -S -u DEVELOPER_DIR -u SDKROOT /usr/bin/swift
//
// kb-layout-sync — tell the Corne which macOS keyboard layout is active.
//
// The firmware keeps Enthium for en and switches to a ЙЦУКЕН layer for ru.
// This reports the current input source over QMK Raw HID whenever it changes
// or the keyboard is plugged in, so the layer follows the OS no matter how
// the layout was switched.
//
//   kb-layout-sync          run until killed, following the OS layout
//   kb-layout-sync en|ru    send one state and exit (for testing)

import Carbon
import Foundation
import IOKit.hid

// Must match the keyboard's USB IDs and HID_LAYOUT_SYNC in keymap.c
let vendorID = 0x4653
let productID = 0x0001
let rawUsagePage = 0xFF60
let rawUsage = 0x61
let syncCommand: UInt8 = 0x4C
let reportSize = 32

func log(_ message: String) {
    FileHandle.standardError.write(Data("kb-layout-sync: \(message)\n".utf8))
}

func osLayoutIsRussian() -> Bool {
    let source = TISCopyCurrentKeyboardInputSource().takeRetainedValue()
    guard let property = TISGetInputSourceProperty(source, kTISPropertyInputSourceLanguages) else {
        return false
    }
    let languages = Unmanaged<CFArray>.fromOpaque(property).takeUnretainedValue() as? [String]
    return languages?.first == "ru"
}

func send(russian: Bool, to device: IOHIDDevice) {
    var report = [UInt8](repeating: 0, count: reportSize)
    report[0] = syncCommand
    report[1] = russian ? 1 : 0
    let result = IOHIDDeviceSetReport(device, kIOHIDReportTypeOutput, 0, report, report.count)
    if result == kIOReturnSuccess {
        log("sent \(russian ? "ru" : "en")")
    } else {
        log("send failed: 0x\(String(UInt32(bitPattern: result), radix: 16))")
    }
}

let manager = IOHIDManagerCreate(kCFAllocatorDefault, IOOptionBits(kIOHIDOptionsTypeNone))
IOHIDManagerSetDeviceMatching(manager, [
    kIOHIDVendorIDKey: vendorID,
    kIOHIDProductIDKey: productID,
    kIOHIDPrimaryUsagePageKey: rawUsagePage,
    kIOHIDPrimaryUsageKey: rawUsage,
] as CFDictionary)

func keyboards() -> [IOHIDDevice] {
    guard let devices = IOHIDManagerCopyDevices(manager) as? Set<IOHIDDevice> else {
        return []
    }
    return Array(devices)
}

let openResult = IOHIDManagerOpen(manager, IOOptionBits(kIOHIDOptionsTypeNone))
if openResult != kIOReturnSuccess {
    log("cannot open HID manager: 0x\(String(UInt32(bitPattern: openResult), radix: 16))")
    exit(1)
}

// One-shot mode
if CommandLine.arguments.count > 1 {
    let argument = CommandLine.arguments[1]
    guard argument == "en" || argument == "ru" else {
        log("usage: kb-layout-sync [en|ru]")
        exit(64)
    }
    let found = keyboards()
    if found.isEmpty {
        log("keyboard not found (is Raw HID enabled in the firmware?)")
        exit(1)
    }
    found.forEach { send(russian: argument == "ru", to: $0) }
    exit(0)
}

// A keyboard that was just plugged in boots in Enthium; bring it up to date
IOHIDManagerRegisterDeviceMatchingCallback(manager, { _, _, _, device in
    log("keyboard connected")
    send(russian: osLayoutIsRussian(), to: device)
}, nil)
IOHIDManagerScheduleWithRunLoop(manager, CFRunLoopGetMain(), CFRunLoopMode.defaultMode.rawValue)

DistributedNotificationCenter.default().addObserver(
    forName: NSNotification.Name(kTISNotifySelectedKeyboardInputSourceChanged as String),
    object: nil,
    queue: .main
) { _ in
    let russian = osLayoutIsRussian()
    keyboards().forEach { send(russian: russian, to: $0) }
}

log("watching layout changes")
RunLoop.main.run()
