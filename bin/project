#!/usr/bin/env bash
#
# project — wire up (or tear down) a Nix devShell for the current directory.
#
# Detects the language + version from the files in $PWD, lets you pick a
# matching devShell (interactively when run with no shell), and points direnv
# at it. Each devShell installs its own pre-commit hooks on entry — alejandra
# for nix, plus rustfmt / ruff / stylua / prettier / clang-format per language.
#
#   project                 detect + interactively pick a devShell
#   project init <shell>    clean, then wire up <shell>
#   project use  <shell>    wire up <shell> without cleaning first
#   project combine a b …   wire up one shell built from several (a+b)
#   project detect          guess the devShell for $PWD (no changes)
#   project list            list available shells
#   project clean           remove .envrc + pre-commit config, deny direnv
#
# A shell name containing `+` is a combo (`rust+node`, `avito.go.1.25+avito.npm`)
# — see the combos section below.

set -uo pipefail

GLOBAL_GITIGNORE_PATH=${HOME}/.gitignore
SHELLS_BASE_PATH=${SHELLS_BASE_PATH:-${HOME}/dots:${HOME}/Avito/shells}
COMBO_CACHE=${COMBO_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/project/combos}

SYSTEM=${SYSTEM:-$(nix eval --raw --impure --expr builtins.currentSystem 2>/dev/null || echo aarch64-darwin)}

# ---------------------------------------------------------------------------
# pretty output
# ---------------------------------------------------------------------------
if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
	B=$'\e[1m' D=$'\e[2m' R=$'\e[0m'
	RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' CYN=$'\e[36m'
else
	B='' D='' R='' RED='' GRN='' YLW='' CYN=''
fi

say() { printf '%s\n' "$*"; }
info() { printf '%s▸%s %s\n' "$CYN" "$R" "$*"; }
ok() { printf '%s✓%s %s\n' "$GRN" "$R" "$*"; }
warn() { printf '%s!%s %s\n' "$YLW" "$R" "$*" >&2; }
die() {
	printf '%s✗%s %s\n' "$RED" "$R" "$*" >&2
	exit 1
}

# ---------------------------------------------------------------------------
# available shells (cached — `nix flake show` is slow)
# ---------------------------------------------------------------------------
SHELL_CACHE=''

build_cache() {
	[[ -n $SHELL_CACHE ]] && return
	local p s shells
	local -a _paths
	[[ -t 2 ]] && printf '%sdiscovering shells…%s' "$D" "$R" >&2
	IFS=: read -r -d '' -a _paths < <(printf '%s:\0' "$SHELLS_BASE_PATH")
	for p in "${_paths[@]}"; do
		[[ -z $p ]] && continue
		shells=$(nix flake show "$p" --json 2>/dev/null |
			jq -r "(.devShells.\"${SYSTEM}\" // {}) | keys[]" 2>/dev/null)
		while IFS= read -r s; do
			[[ -z $s ]] && continue
			SHELL_CACHE+="${s}	${p}"$'\n'
		done <<<"$shells"
	done
	[[ -t 2 ]] && printf '\r\e[K' >&2
}

list_shells() { build_cache; printf '%s' "$SHELL_CACHE" | awk -F'\t' 'NF{print $1}'; }
flake_of() { build_cache; printf '%s' "$SHELL_CACHE" | awk -F'\t' -v s="$1" '$1==s{print $2; exit}'; }
has_shell() { list_shells | grep -Fxq "$1"; }
# shells contributed by a single root (handed to that root's hook)
shells_in_root() { build_cache; printf '%s' "$SHELL_CACHE" | awk -F'\t' -v r="$1" '$2==r{print $1}'; }

# ---------------------------------------------------------------------------
# combos — one devShell built from several (`rust+node`, `avito.go.1.25+avito.npm`)
#
# Stacking `use flake` in a single .envrc does not compose: nix-direnv keeps one
# profile per directory (the second call rm's the first one's GC root *and* its
# cached rc, so that shell re-evaluates on every reload and is left for the next
# `nix gc`), and every mkShell sets NIX_CFLAGS_COMPILE / NIX_LDFLAGS, so only the
# last shell's C deps stay visible to the compiler. git-hooks.nix is likewise
# exclusive about .pre-commit-config.yaml — a second installer unlinks the first
# one's symlink, keeping only its own hooks.
#
# So combining happens inside nix, via `mkShell { inputsFrom = [ … ]; }`, in a
# flake generated below. `inputsFrom` merges {native,}buildInputs and
# concatenates shellHooks, but drops plain env attrs (GOPATH, GOTOOLCHAIN,
# VAULT_ADDR, …) — the generated flake forwards those by hand and installs the
# union of the picks' hook sets (published as `flake.devshellHooks` by each
# root; see ../modules/devshells/hooks.nix).
#
# Order matters and is the order you pick in: earlier picks come first on PATH,
# and later picks win any env var or hook the picks disagree on (the shell warns
# on entry when that happens). Put the language that compiles first.
#
# Generated flakes are cached one per combo under $COMBO_CACHE and shared across
# projects; each project's .envrc just points at one.
# ---------------------------------------------------------------------------
is_combo() { [[ $1 == *+* ]]; }

combo_parts() {
	local IFS=+
	local -a parts
	read -r -a parts <<<"$1"
	printf '%s\n' "${parts[@]}"
}

combo_dir() { printf '%s/%s' "$COMBO_CACHE" "$1"; }

# gen_combo <name> — (re)write the generated flake for <name>; echo its dir.
gen_combo() {
	local name=$1 dir part flake primary idx i
	local -a parts=() roots=() rootof=()
	mapfile -t parts < <(combo_parts "$name")
	((${#parts[@]} > 1)) || die "not a combo: ${B}${name}${R}"

	# resolve each pick to the shells root that provides it, de-duplicating roots
	for part in "${parts[@]}"; do
		has_shell "$part" || die "unknown shell in combo: ${B}${part}${R}"
		flake=$(flake_of "$part")
		idx=-1
		for i in "${!roots[@]}"; do
			if [[ ${roots[i]} == "$flake" ]]; then
				idx=$i
				break
			fi
		done
		if ((idx < 0)); then
			roots+=("$flake")
			idx=$((${#roots[@]} - 1))
		fi
		rootof+=("$idx")
	done

	# the first root supplies nixpkgs for the wrapper shell + the hooks builder
	primary=${SHELLS_BASE_PATH%%:*}
	dir=$(combo_dir "$name")
	mkdir -p "$dir" || die "cannot create ${dir}"

	{
		printf '%s\n' \
			'# Generated by `project` — do not edit, it is rewritten on every' \
			"# \`project use ${name}\`." \
			'#' \
			'# One devShell built from several: tools from each pick via `inputsFrom`,' \
			'# their plain env attrs forwarded by hand (`inputsFrom` drops them), and one' \
			"# pre-commit installer built from the union of the picks' hook sets." \
			'#' \
			'# Input-less + `--impure` on purpose: resolving the shells roots with' \
			'# `builtins.getFlake` means no flake.lock pinning them here, so edits to a' \
			'# shell land on the next `direnv reload` instead of needing a' \
			'# `nix flake update` in this directory.' \
			'{'
		printf '  description = "project combo devShell: %s";\n\n' "${name//+/ + }"
		printf '  outputs = _: let\n'
		printf '    comboName = "%s";\n' "$name"
		printf '    system = "%s";\n\n' "$SYSTEM"
		printf '    primary = builtins.getFlake "path:%s";\n' "$primary"
		printf '    roots = {\n'
		for i in "${!roots[@]}"; do
			if [[ ${roots[i]} == "$primary" ]]; then
				printf '      r%d = primary;\n' "$i"
			else
				printf '      r%d = builtins.getFlake "path:%s";\n' "$i" "${roots[i]}"
			fi
		done
		printf '    };\n'
		printf '    picks = [\n'
		for i in "${!parts[@]}"; do
			printf '      {\n        root = roots.r%s;\n        name = "%s";\n      }\n' \
				"${rootof[i]}" "${parts[i]}"
		done
		printf '    ];\n\n'
		cat <<'NIX_BODY'
    lib = primary.inputs.nixpkgs.lib;
    pkgs = primary.inputs.nixpkgs.legacyPackages.${system};

    shells = map (p: p.root.devShells.${system}.${p.name}) picks;

    # `devshellHooks` is a prefix map: the longest key that prefixes the shell
    # name wins, so `avito.go` covers every `avito.go.<version>`.
    hooksOf = p: let
      published = p.root.devshellHooks or {};
      matching = lib.filter (k: lib.hasPrefix k p.name) (lib.attrNames published);
      best =
        lib.foldl'
        (
          acc: k:
            if acc == null || lib.stringLength k > lib.stringLength acc
            then k
            else acc
        )
        null
        matching;
    in
      if best == null
      then {}
      else published.${best};

    hookSets = map hooksOf picks;
    run = primary.lib.devshellHooks system (lib.foldl' (acc: h: acc // h) {} hookSets);

    # `inputsFrom` drops plain env attrs, so forward them; derivation plumbing
    # (name, builder, outPath, __sandboxProfile, …) is filtered back out.
    blocked = [
      "args"
      "buildCommand"
      "buildPhase"
      "builder"
      "drvPath"
      "name"
      "outPath"
      "outputName"
      "phases"
      "shellHook"
      "stdenv"
      "system"
      "type"
    ];
    envOf = drv:
      lib.filterAttrs
      (n: v: builtins.isString v && !(builtins.elem n blocked) && !(lib.hasPrefix "__" n))
      drv;
    envs = map envOf shells;

    # Anything two picks disagree on is resolved last-pick-wins; say so on entry
    # rather than resolving it silently.
    conflicts = sets: let
      names = lib.unique (lib.concatMap lib.attrNames sets);
      valuesOf = n: lib.unique (map (s: s.${n}) (lib.filter (s: s ? ${n}) sets));
    in
      lib.filter (n: lib.length (valuesOf n) > 1) names;
    warn = kind: names:
      lib.optionalString (names != []) ''
        echo "project: ${comboName}: ${kind} set by more than one shell, last pick wins:${
          lib.concatMapStrings (n: " " + n) names
        }" >&2
      '';
  in {
    devShells.${system}.default = pkgs.mkShell (
      (lib.foldl' (acc: e: acc // e) {} envs)
      // {
        name = "combo-" + comboName;
        inputsFrom = shells;
        # Deliberately NOT adding `run.enabledPackages`: git-hooks writes
        # absolute store paths as hook entries, so the hook tools do not need to
        # be on PATH — and `packages` becomes nativeBuildInputs, which precedes
        # everything from `inputsFrom`. The gofmt hook ships a whole `go`, so
        # adding it would put an unpinned go ahead of the one the pick chose
        # (`avito.go.1.25` + GOTOOLCHAIN=go1.25.7 would run go 1.26 and try to
        # fetch a toolchain). Each pick still brings its own hook tools along.
        # An env attr, so it is exported before any pick's shellHook runs and
        # each pick's own pre-commit installer stands down (this shell installs
        # the union instead).
        PROJECT_COMBO_HOOKS = "1";
        shellHook =
          warn "env" (conflicts envs)
          + warn "hooks" (conflicts hookSets)
          + run.shellHook;
      }
    );
  };
}
NIX_BODY
	} >"$dir/flake.nix"

	printf '%s' "$dir"
}

# ---------------------------------------------------------------------------
# external hooks — a shells root may ship an executable `.project-hook` to
# register its own suggestions + checks:
#   <root>/.project-hook suggest         -> "<shell>\t<reason>\t<version>" for $PWD
#   <root>/.project-hook checks <shell>  -> the checks <shell> installs
# It runs in $PWD with $PROJECT_SHELLS (this root's shells) + $PROJECT_SYSTEM set.
# ---------------------------------------------------------------------------
run_hook() {
	local root=$1 sub=$2
	shift 2
	local hook=$root/.project-hook
	[[ -x $hook ]] || return 1
	PROJECT_SYSTEM=$SYSTEM PROJECT_SHELLS=$(shells_in_root "$root") "$hook" "$sub" "$@" 2>/dev/null
}

# checks a shell installs — from its root's hook, else the built-in map below
# (which mirrors modules/devshells/hooks.nix).
builtin_checks() {
	case $1 in
	rust) echo "alejandra rustfmt" ;;
	node) echo "alejandra prettier" ;;
	python3) echo "alejandra ruff ruff-format" ;;
	lua) echo "alejandra stylua" ;;
	nix) echo "alejandra statix deadnix" ;;
	qmk) echo "alejandra" ;;
	esac
}

# checks_for <shell> -> space-separated check names ('' if none). For a combo,
# the union of its parts — which can name a check a later pick disables, since
# only the generated flake resolves those conflicts (see the combos section).
checks_for() {
	local out='' part
	if is_combo "$1"; then
		while IFS= read -r part; do
			out+=" $(checks_for "$part")"
		done < <(combo_parts "$1")
	else
		out=$(run_hook "$(flake_of "$1")" checks "$1")
		[[ -z $out ]] && out=$(builtin_checks "$1")
	fi
	printf '%s' "$out" | tr ' \n' '\n\n' | awk 'NF && !seen[$0]++' | tr '\n' ' ' | awk '{$1=$1};1'
}

# ---------------------------------------------------------------------------
# detection — guess the devShell + version from files in $PWD
# ---------------------------------------------------------------------------
DETECT_LANG='' DETECT_REASON='' DETECT_VERSION=''

# firstfile <patterns...> — echo the first existing file/glob match, else fail.
# nullglob drops non-matching globs, but literal names (no wildcard) survive
# expansion regardless, so each candidate still needs an explicit -e test.
firstfile() {
	local g m
	local -a matches
	shopt -s nullglob
	for g in "$@"; do
		matches=($g)
		for m in "${matches[@]}"; do
			if [[ -e $m ]]; then
				printf '%s\n' "$m"
				shopt -u nullglob
				return 0
			fi
		done
	done
	shopt -u nullglob
	return 1
}

detect_version() {
	local lang=$1 v=''
	case $lang in
	node)
		if [[ -f .nvmrc ]]; then v=$(<.nvmrc)
		elif [[ -f .node-version ]]; then v=$(<.node-version)
		elif [[ -f package.json ]]; then v=$(jq -r '.engines.node // empty' package.json 2>/dev/null)
		elif [[ -f .tool-versions ]]; then v=$(awk '/^nodejs /{print $2}' .tool-versions)
		fi
		;;
	python3)
		if [[ -f .python-version ]]; then v=$(<.python-version)
		elif [[ -f pyproject.toml ]]; then v=$(grep -oE 'requires-python.*' pyproject.toml | head -1)
		elif [[ -f .tool-versions ]]; then v=$(awk '/^python /{print $2}' .tool-versions)
		fi
		;;
	rust)
		if [[ -f rust-toolchain.toml ]]; then v=$(grep -oE 'channel *= *"[^"]+"' rust-toolchain.toml | head -1)
		elif [[ -f rust-toolchain ]]; then v=$(<rust-toolchain)
		elif [[ -f .tool-versions ]]; then v=$(awk '/^rust /{print $2}' .tool-versions)
		fi
		;;
	lua)
		[[ -f .tool-versions ]] && v=$(awk '/^lua /{print $2}' .tool-versions)
		;;
	esac
	# keep only the version-looking part, collapse whitespace
	grep -oE '[0-9]+(\.[0-9]+)*' <<<"$v" | head -1
}

detect() {
	DETECT_LANG='' DETECT_REASON='' DETECT_VERSION=''
	local f
	if f=$(firstfile Cargo.toml); then DETECT_LANG=rust
	elif f=$(firstfile package.json pnpm-lock.yaml yarn.lock .nvmrc .node-version); then DETECT_LANG=node
	elif f=$(firstfile pyproject.toml requirements.txt setup.py Pipfile .python-version '*.py'); then DETECT_LANG=python3
	elif f=$(firstfile qmk.json keymap.c rules.mk); then DETECT_LANG=qmk
	elif f=$(firstfile .luarc.json stylua.toml init.lua '*.lua'); then DETECT_LANG=lua
	# nix is the last fallback: a rust/node project with a flake.nix should still
	# detect its real language above before landing here.
	elif f=$(firstfile flake.nix default.nix shell.nix '*.nix'); then DETECT_LANG=nix
	else return 1
	fi
	DETECT_REASON=$f
	DETECT_VERSION=$(detect_version "$DETECT_LANG")
	return 0
}

# ---------------------------------------------------------------------------
# suggestion — which shell to pre-select for $PWD. External `.project-hook`s are
# more specific (they encode project-type knowledge, e.g. go.mod -> avito.go.X),
# so they win over the built-in language detection above; built-in is the
# fallback. Only a shell that actually exists can be suggested.
# ---------------------------------------------------------------------------
SUGGEST_SHELL='' SUGGEST_REASON='' SUGGEST_VERSION=''

suggest() {
	SUGGEST_SHELL='' SUGGEST_REASON='' SUGGEST_VERSION=''
	local p out shell reason ver
	local -a _paths
	IFS=: read -r -d '' -a _paths < <(printf '%s:\0' "$SHELLS_BASE_PATH")
	for p in "${_paths[@]}"; do
		[[ -z $p ]] && continue
		out=$(run_hook "$p" suggest) || continue
		IFS=$'\t' read -r shell reason ver <<<"$out"
		if [[ -n $shell ]] && has_shell "$shell"; then
			SUGGEST_SHELL=$shell SUGGEST_REASON=${reason:-$(basename "$p")} SUGGEST_VERSION=$ver
			return 0
		fi
	done
	if detect && has_shell "$DETECT_LANG"; then
		SUGGEST_SHELL=$DETECT_LANG SUGGEST_REASON=$DETECT_REASON SUGGEST_VERSION=$DETECT_VERSION
		return 0
	fi
	return 1
}

# pretty one-liner describing the suggestion
suggest_line() {
	local v=${SUGGEST_VERSION:+ v$SUGGEST_VERSION}
	printf '%s%s%s%s %s(%s%s)%s' \
		"$B" "$GRN" "$SUGGEST_SHELL" "$R" \
		"$D" "$SUGGEST_REASON" "$v" "$R"
}

# ---------------------------------------------------------------------------
# direnv / gitignore plumbing
# ---------------------------------------------------------------------------
gitignore() {
	touch "$GLOBAL_GITIGNORE_PATH"
	git config --get core.excludesfile | grep -Fxq "$GLOBAL_GITIGNORE_PATH" ||
		git config --global core.excludesfile "$GLOBAL_GITIGNORE_PATH"
	grep -Fxq "$1" "$GLOBAL_GITIGNORE_PATH" || printf '%s\n' "$1" >>"$GLOBAL_GITIGNORE_PATH"
}

clean() {
	direnv deny . &>/dev/null
	rm -f .envrc &>/dev/null
	# pre-commit installs itself from the devShell shellHook; tidy up on teardown.
	command -v pre-commit &>/dev/null && pre-commit uninstall &>/dev/null
	rm -f .pre-commit-config.yaml &>/dev/null
}

use_shell() {
	local name=$1 flake part dir
	# The tmux window title is set for every direnv dir by the direnv stdlib hook
	# (see modules/home/fish.nix), so the .envrc just needs to wire the shell.
	# The `# project:` stamp is what `current_shell` reads back.
	if is_combo "$name"; then
		while IFS= read -r part; do
			has_shell "$part" || {
				warn "unknown shell in combo ${B}${name}${R}: ${B}${part}${R}"
				say ''
				list_available
				exit 1
			}
		done < <(combo_parts "$name")

		dir=$(gen_combo "$name") || exit 1
		{
			printf '# project: %s\n' "$name"
			# `path:` pins the fetcher: a bare path inside a git repo resolves to
			# the repo root instead, and the generated flake — untracked — would
			# not be in the store copy. nix-direnv strips the prefix to find the
			# directory it watches. --impure: the flake resolves the shells roots
			# with getFlake.
			printf 'use flake path:%s --impure\n' "$dir"
		} >.envrc

		info "use flake ${B}${dir}${R} ${D}(${name//+/ + })${R}"
	else
		flake=$(flake_of "$name")
		[[ -z $flake ]] && {
			warn "unknown shell: ${B}${name}${R}"
			say ''
			list_available
			exit 1
		}

		{
			printf '# project: %s\n' "$name"
			printf 'use flake %s#\\"%s\\"\n' "$flake" "$name"
		} >.envrc

		info "use flake ${B}${flake}#${name}${R}"
	fi

	if direnv allow . 2>/dev/null; then
		ok 'direnv allowed'
	else
		warn 'direnv allow failed — run it manually'
	fi

	gitignore .direnv
	gitignore .envrc
	gitignore .pre-commit-config.yaml
}

# ---------------------------------------------------------------------------
# listing / interactive picker
# ---------------------------------------------------------------------------
current_shell() {
	[[ -f .envrc ]] || return 1
	local cur
	# `use_shell` stamps the name; fall back to parsing the flake ref for .envrc
	# files written before that (or by hand). The `.` in the class matters —
	# without it `avito.go.1.25` reads back as `avito`.
	cur=$(sed -n 's/^# project: //p' .envrc | head -1)
	[[ -z $cur ]] && cur=$(grep -oE '#\\?"?[A-Za-z0-9_.+-]+\\?"?' .envrc | head -1 | tr -d '#\\"')
	[[ -n $cur ]] && printf '%s' "$cur"
}

# list_available [verbose] — print shells with current/suggested markers; in
# verbose mode also show the checks each shell installs.
list_available() {
	local verbose=${1:-} cur s det='' checks
	cur=$(current_shell) || cur=''
	suggest && det=$SUGGEST_SHELL

	info "available shells ${D}(${SHELLS_BASE_PATH})${R}:"
	while IFS= read -r s; do
		if [[ $s == "$cur" && $s == "$det" ]]; then
			printf '   %s★ %s%s%s %s(current · suggested)%s\n' "$GRN" "$B" "$s" "$R" "$D" "$R"
		elif [[ $s == "$cur" ]]; then
			printf '   %s● %s%s%s %s(current)%s\n' "$GRN" "$B" "$s" "$R" "$D" "$R"
		elif [[ $s == "$det" ]]; then
			printf '   %s★ %s%s%s %s(suggested)%s\n' "$YLW" "$B" "$s" "$R" "$D" "$R"
		else
			printf '     %s\n' "$s"
		fi
		if [[ $verbose == verbose ]]; then
			checks=$(checks_for "$s")
			[[ -n $checks ]] && printf '       %schecks: %s%s\n' "$D" "$checks" "$R"
		fi
	done < <(list_shells)

	# a combo is not in the list above — show it separately when it is current
	if [[ -n $cur ]] && is_combo "$cur"; then
		printf '   %s● %s%s%s %s(current · combo)%s\n' "$GRN" "$B" "$cur" "$R" "$D" "$R"
		[[ $verbose == verbose ]] && printf '       %schecks: %s%s\n' "$D" "$(checks_for "$cur")" "$R"
	fi

	[[ -n $det ]] && printf '   %s↳ suggested from %s/: %s\n' \
		"$D" "$(basename "$PWD")" "$(suggest_line)"
	printf '   %s↳ combine any of them with +: %sproject use rust+node%s %s(or tab in the picker)%s\n' \
		"$D" "$B" "$R" "$D" "$R"

	if [[ $verbose == verbose ]]; then
		local c
		local -a cached=()
		while IFS= read -r c; do
			[[ -n $c ]] && cached+=("$(basename "$c")")
		done < <(find "$COMBO_CACHE" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort)
		if ((${#cached[@]})); then
			say ''
			info "generated combos ${D}(${COMBO_CACHE})${R}:"
			printf '     %s\n' "${cached[@]}"
		fi
	fi
}

menu_select() {
	local default=$1
	shift
	local -a opts=("$@")
	local i n reply prompt tok out=''
	for i in "${!opts[@]}"; do
		n=$((i + 1))
		if [[ ${opts[i]} == "$default" ]]; then
			printf '  %s%2d) %s%s %s★%s\n' "$B" "$n" "${opts[i]}" "$R" "$YLW" "$R" >&2
		else
			printf '  %2d) %s\n' "$n" "${opts[i]}" >&2
		fi
	done
	prompt="pick a shell ${D}(several = combo, e.g. '1 3')${R}"
	[[ -n $default ]] && prompt+=" ${D}[$default]${R}"
	printf '%s%s ›%s ' "$CYN" "$prompt" "$R" >&2
	read -r reply
	[[ -z $reply ]] && { printf '%s' "$default"; return; }
	# numbers (or names) separated by space/comma -> a+b combo, in pick order
	for tok in ${reply//,/ }; do
		if [[ $tok =~ ^[0-9]+$ ]] && ((tok >= 1 && tok <= ${#opts[@]})); then
			out+="+${opts[tok - 1]}"
		else
			out+="+${tok}"
		fi
	done
	printf '%s' "${out#+}"
}

# pick — fill REPLY_SHELL via fzf (if present) or a numbered menu
pick() {
	local -a shells ordered
	mapfile -t shells < <(list_shells)
	((${#shells[@]})) || die "no shells found under ${SHELLS_BASE_PATH}"

	local default=''
	if suggest; then
		default=$SUGGEST_SHELL
		info "suggested $(suggest_line)"
	else
		info "no shell detected for ${B}$(basename "$PWD")/${R}"
	fi

	local s
	if command -v fzf &>/dev/null; then
		ordered=()
		[[ -n $default ]] && ordered+=("$default")
		for s in "${shells[@]}"; do [[ $s == "$default" ]] || ordered+=("$s"); done
		# --multi: several picks become a combo, joined in list order (so the
		# suggested shell, hoisted to the top, comes first on PATH).
		REPLY_SHELL=$(printf '%s\n' "${ordered[@]}" |
			fzf --multi --height='~40%' --reverse --prompt='devshell › ' \
				--header="${default:+suggested: $default · }tab to combine, enter to confirm, esc to cancel" |
			paste -sd+ -)
		[[ -z $REPLY_SHELL ]] && die 'cancelled'
	else
		REPLY_SHELL=$(menu_select "$default" "${shells[@]}")
		[[ -z $REPLY_SHELL ]] && die 'cancelled'
	fi
}

# ---------------------------------------------------------------------------
# usage / dispatch
# ---------------------------------------------------------------------------
usage() {
	say "${B}project${R} — Nix devShell setup for the current directory"
	say ''
	say "${B}usage:${R} project [command] [shell]"
	say ''
	say "  ${CYN}(no args)${R}      detect + interactively pick a devShell"
	say "  ${CYN}init${R} [shell]   clean, then wire up [shell] (interactive if omitted)"
	say "  ${CYN}use${R}  <shell>   wire up <shell> without cleaning first"
	say "  ${CYN}combine${R} a b …  wire up one shell built from several (same as ${B}a+b${R})"
	say "  ${CYN}detect${R}         guess the devShell for \$PWD (no changes)"
	say "  ${CYN}list${R}           list available shells + their checks"
	say "  ${CYN}checks${R} [shell]  show the checks a shell installs"
	say "  ${CYN}clean${R}          remove .envrc + pre-commit config, deny direnv"
	say ''
	say "${D}Any shell name with a + is a combo: its parts' tools all land on PATH and${R}"
	say "${D}their pre-commit hooks are unioned. Earlier parts come first on PATH; later${R}"
	say "${D}parts win any env var or hook they disagree on (the shell says so on entry).${R}"
	say ''
	say "${D}A shells root may ship an executable .project-hook to register its own${R}"
	say "${D}suggestions + checks (see ${SHELLS_BASE_PATH%%:*}/bin/project header).${R}"
	say ''
	list_available
}

main() {
	local checks part combo
	case ${1:-} in
	'')
		pick
		clean
		use_shell "$REPLY_SHELL"
		;;
	init)
		case $# in
		1) pick; clean; use_shell "$REPLY_SHELL" ;;
		2) clean; use_shell "$2" ;;
		*) usage; exit 1 ;;
		esac
		;;
	use | nix | shell)
		[[ $# -eq 2 ]] || { usage; exit 1; }
		use_shell "$2"
		;;
	combine | combo)
		shift
		(($# >= 2)) || { usage; exit 1; }
		combo=$(printf '%s+' "$@")
		clean
		use_shell "${combo%+}"
		;;
	detect)
		if suggest; then
			info "suggested $(suggest_line)"
			checks=$(checks_for "$SUGGEST_SHELL")
			[[ -n $checks ]] && info "checks: ${D}${checks}${R}"
		else
			info "nothing detected in ${B}$(basename "$PWD")/${R}"
		fi
		;;
	checks)
		case $# in
		2)
			if is_combo "$2"; then
				while IFS= read -r part; do
					has_shell "$part" || warn "no devShell named ${B}${part}${R} is available"
				done < <(combo_parts "$2")
			else
				has_shell "$2" || warn "no devShell named ${B}$2${R} is available"
			fi
			checks=$(checks_for "$2")
			info "checks for ${B}$2${R}: ${D}${checks:-none}${R}"
			;;
		1)
			if suggest; then
				checks=$(checks_for "$SUGGEST_SHELL")
				info "checks for suggested ${B}${SUGGEST_SHELL}${R}: ${D}${checks:-none}${R}"
			else
				info "no shell detected — try ${B}project checks <shell>${R}"
			fi
			;;
		*) usage; exit 1 ;;
		esac
		;;
	list | ls)
		list_available verbose
		;;
	clean)
		[[ $# -eq 1 ]] || { usage; exit 1; }
		clean
		ok 'cleaned direnv + pre-commit config'
		;;
	-h | --help | help)
		usage
		;;
	*)
		usage
		exit 1
		;;
	esac
}

main "$@"
