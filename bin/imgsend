#!/usr/bin/env bash
set -euo pipefail

paste=false
if [[ ${1:-} == --paste ]]; then
  paste=true
  shift
fi
if [[ $# -ne 1 || $1 == -h || $1 == --help || $1 == -* ]]; then
  printf 'Usage: imgsend [--paste] SSH_ALIAS\n' >&2
  printf '  --paste  Also insert the path into the current Ghostty terminal (macOS).\n' >&2
  exit 2
fi

target=$1
platform=$(uname -s)
terminal_id=
if $paste; then
  if [[ $platform != Darwin ]]; then
    printf 'imgsend: --paste requires Ghostty on macOS\n' >&2
    exit 2
  fi
  # Remember the originating surface before SSH: changing windows or tabs
  # during the upload must not redirect the path to another terminal.
  terminal_id=$(
    osascript <<'APPLESCRIPT'
if not application "Ghostty" is running then error "Ghostty is not running"
tell application "Ghostty"
  return id of focused terminal of selected tab of front window
end tell
APPLESCRIPT
  )
fi
temporary=$(mktemp -d "${TMPDIR:-/tmp}/imgsend.XXXXXXXX")
trap 'rm -rf "$temporary"' EXIT

extension=
image=
case $platform in
Darwin)
  extension=png
  image="$temporary/image.png"
  pngpaste "$image" || {
    printf 'imgsend: no image in the Mac clipboard\n' >&2
    exit 1
  }
  ;;
Linux)
  if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
    printf 'imgsend: a Wayland session is required on Linux\n' >&2
    exit 1
  fi
  offered=$(wl-paste --list-types)
  for mime in image/png image/jpeg image/webp image/gif image/tiff image/bmp; do
    if printf '%s\n' "$offered" | grep -Fxq "$mime"; then
      case $mime in
      image/png) extension=png ;;
      image/jpeg) extension=jpg ;;
      image/webp) extension=webp ;;
      image/gif) extension=gif ;;
      image/tiff) extension=tiff ;;
      image/bmp) extension=bmp ;;
      esac
      image="$temporary/image.$extension"
      wl-paste --type "$mime" >"$image"
      break
    fi
  done
  if [[ -z $image ]]; then
    printf 'imgsend: no supported image in the Wayland clipboard\n' >&2
    exit 1
  fi
  ;;
*)
  printf 'imgsend: macOS and Linux Wayland are supported\n' >&2
  exit 1
  ;;
esac

if [[ ! -s $image ]]; then
  printf 'imgsend: clipboard image is empty\n' >&2
  exit 1
fi

# The extension comes only from the fixed MIME list above. SSH uses the alias
# and identity from the caller's configuration; no remote shell input is taken
# from the clipboard or from the SSH alias.
# shellcheck disable=SC2016
remote_command='set -eu
umask 077
directory=$(mktemp -d /tmp/imgsend.XXXXXXXX)
image="$directory/image.'$extension'"
if cat > "$image"; then
  printf "%s\n" "$image"
else
  rm -rf "$directory"
  exit 1
fi'
# SSH invokes the remote user's login shell, which may be fish.
remote_command="/bin/sh -c '$remote_command'"

if ! remote_path=$(ssh -T -o BatchMode=yes -- "$target" "$remote_command" <"$image"); then
  printf 'imgsend: upload to %s failed\n' "$target" >&2
  exit 1
fi
if [[ $remote_path != /tmp/imgsend.*/image."$extension" || $remote_path == *$'\n'* ]]; then
  printf 'imgsend: remote host returned an unexpected path\n' >&2
  exit 1
fi

case $platform in
Darwin) printf '%s' "$remote_path" | pbcopy ;;
Linux) printf '%s' "$remote_path" | wl-copy --type text/plain ;;
esac
printf '%s\n' "$remote_path"

if $paste; then
  # Native paste-style input avoids synthetic keystrokes and held modifiers.
  # Pass values as arguments rather than interpolating AppleScript source.
  osascript - "$terminal_id" "$remote_path" <<'APPLESCRIPT' || {
on run argv
  set terminalID to item 1 of argv
  tell application "Ghostty"
    input text (item 2 of argv) to (first terminal whose id is terminalID)
  end tell
end run
APPLESCRIPT
    printf 'imgsend: paste failed; the remote path is still on the clipboard\n' >&2
    exit 1
  }
fi
