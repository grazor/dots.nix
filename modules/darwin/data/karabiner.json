{
    "global": { "check_for_updates_on_startup": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Ghostty: Ctrl+Shift+V uploads clipboard image to dev and pastes its path",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"],
                                        "type": "frontmost_application_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "v",
                                    "modifiers": {
                                        "mandatory": ["control", "shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [
                                    {
                                        "shell_command": "export PATH='/etc/profiles/per-user/smporyvaev/bin:/run/current-system/sw/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin'; /Users/smporyvaev/.bin/imgsend --paste dev",
                                        "repeat": false
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Toggle mic",
                        "manipulators": [
                            {
                                "from": { "key_code": "f4" },
                                "to": [{ "shell_command": "osascript ~/.bin/mic.scpt" }],
                                "type": "basic"
                            },
                            {
                                "from": { "key_code": "f18" },
                                "to": [{ "shell_command": "osascript ~/.bin/mic.scpt" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Insert jira url",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["control", "command"] }
                                },
                                "to": [{ "shell_command": "~/.bin/atask" }],
                                "to_after_key_up": [
                                    {
                                        "key_code": "v",
                                        "modifiers": "command"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Map period (.) to question mark (?)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ru" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "7",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "slash",
                                        "modifiers": ["shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Map comma (,) to slash (/)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ru" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "6",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [{ "key_code": "slash" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Map question mark (?) to comma (,)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ru" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "slash",
                                    "modifiers": { "mandatory": ["shift"] }
                                },
                                "to": [
                                    {
                                        "key_code": "6",
                                        "modifiers": ["shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Map slash (/) to period (.)",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ru" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": { "key_code": "slash" },
                                "to": [
                                    {
                                        "key_code": "7",
                                        "modifiers": ["shift"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Change grave accent (`) to ё in Russian layout",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "language": "ru" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "grave_accent_and_tilde",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "backslash" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Mac OSX: disable cmd + option + h + m to prevent minimising all windows",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": {
                                        "mandatory": ["command", "option"],
                                        "optional": ["any"]
                                    }
                                },
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "m",
                                    "modifiers": {
                                        "mandatory": ["command", "option"],
                                        "optional": ["any"]
                                    }
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Mac OSX: disable cmd + h to prevent minimising an application window",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Mac OSX: double-tap right shift key → caps lock toggle",
                        "enabled": false,
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "name": "right_shift pressed",
                                        "type": "variable_if",
                                        "value": 1
                                    },
                                    {
                                        "identifiers": [{ "is_built_in_keyboard": true }],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "caps_lock" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "identifiers": [{ "is_built_in_keyboard": true }],
                                        "type": "device_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "right_shift",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "right_shift pressed",
                                            "value": 1
                                        }
                                    },
                                    { "key_code": "right_shift" }
                                ],
                                "to_delayed_action": {
                                    "to_if_canceled": [
                                        {
                                            "set_variable": {
                                                "name": "right_shift pressed",
                                                "value": 0
                                            }
                                        }
                                    ],
                                    "to_if_invoked": [
                                        {
                                            "set_variable": {
                                                "name": "right_shift pressed",
                                                "value": 0
                                            }
                                        }
                                    ]
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Screenshot at f5",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "f5",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "4",
                                        "modifiers": ["left_shift", "left_gui", "left_control"]
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "grp:shift_caps_toggle",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "mandatory": ["left_shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "select_input_source": { "language": "^ru$" } }],
                                "type": "basic"
                            },
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": {
                                        "mandatory": [],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "select_input_source": { "language": "^en$" } }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "apple_vendor_top_case_key_code": "keyboard_fn" },
                            "to": [{ "key_code": "left_control" }]
                        },
                        {
                            "from": { "key_code": "left_control" },
                            "to": [{ "apple_vendor_top_case_key_code": "keyboard_fn" }]
                        }
                    ]
                },
                {
                    "identifiers": {
                        "is_pointing_device": true,
                        "product_id": 49970,
                        "vendor_id": 1133
                    },
                    "ignore": false,
                    "ignore_vendor_events": true,
                    "mouse_flip_vertical_wheel": true,
                    "pointing_motion_wheels_multiplier": 1.4,
                    "pointing_motion_xy_multiplier": 1.4
                }
            ],
            "name": "Working",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        },
        {
            "name": "Default mac",
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" }
        }
    ]
}
